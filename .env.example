# Local profile; no paid API calls or downloaded models.
ATLAS_ENVIRONMENT=local
ATLAS_DATABASE_URL=sqlite:///data/atlas.db
ATLAS_INGESTION_MODE=local
ATLAS_DENSE_BACKEND=lsa
ATLAS_VECTOR_BACKEND=memory
ATLAS_RERANKER=lexical
ATLAS_GENERATOR=extractive
# Set an API key to protect all data and query routes.
ATLAS_API_KEY=
ATLAS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional neural profile: install .[neural], then select neural / cross_encoder.
ATLAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ATLAS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Pin model commit revisions before recording neural benchmarks.
# ATLAS_EMBEDDING_REVISION=
# ATLAS_RERANKER_REVISION=
# HTTP generation works with a local or hosted compatible chat-completion server.
# ATLAS_GENERATOR=chat
# ATLAS_LLM_BASE_URL=http://localhost:11434/v1
# ATLAS_LLM_MODEL=your-model
# ATLAS_LLM_KEY=
# Set actual provider pricing. For a free local server explicitly set:
# ATLAS_LLM_FREE_INFERENCE=true
# ATLAS_INPUT_COST_PER_MILLION=0
# ATLAS_OUTPUT_COST_PER_MILLION=0
# Compose credentials: generate with python scripts/bootstrap.py.
# POSTGRES_PASSWORD=
# GRAFANA_PASSWORD=
