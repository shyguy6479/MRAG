{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml",
      "functions": {
        "app/main.py": {
          "maxDuration": 60,
          "includeFiles": "{src/atlasrag/**,workers/**,benchmarks/results/local.json,benchmarks/results/neural.json,benchmarks/questions.json}",
          "excludeFiles": "{apps/web/**,docs/screenshots/**,tests/**,.venv/**,data/**,.cursor/**,.agents/**,gateway/**,.vercel/**}"
        },
        "workers/vercel_tasks.py": {
          "maxDuration": 60,
          "includeFiles": "src/atlasrag/**",
          "excludeFiles": "{apps/web/**,docs/screenshots/**,tests/**,.venv/**,data/**,.cursor/**,.agents/**,gateway/**,.vercel/**}"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm ci",
      "routes": [
        {
          "handle": "filesystem"
        },
        {
          "src": "/(.*)",
          "dest": "/index.html"
        }
      ]
    },
    "gateway": {
      "root": "gateway",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "MRAG_BACKEND_URL"
        }
      ],
      "functions": {
        "main.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
